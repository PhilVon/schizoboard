{
  "name": "schizoboard",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && npm run typecheck && vite build",
    "preview": "vite preview",
    "spike:fetch": "node scripts/fetch-spike-photos.mjs",
    "spike:media": "node scripts/make-spike-media.mjs",
    "spike:video": "node scripts/spike-video.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "spike:scan": "node scripts/make-scan-pdf.mjs",
    "spike:long": "node scripts/make-long-pdf.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "fractional-indexing": "^4.0.0",
    "lib0": "^0.2.117",
    "perfect-freehand": "^1.2.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "happy-dom": "^20.11.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "y-websocket": "^1.5.4"
  }
}
